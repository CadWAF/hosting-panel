[Unit]
Description=Hosting Panel Backup Service
After=network.target

[Service]
ExecStart=/usr/local/bin/backup --socket /run/hostingpanel/backup.sock --state /var/lib/hostingpanel/backup --notifier-socket /run/hostingpanel/notifier.sock
Restart=always
RestartSec=2
User=root
# Sockets are created group-owned by hostingpanel so the Panel (member of that group) can reach them.
Group=hostingpanel
StateDirectory=hostingpanel

[Install]
WantedBy=multi-user.target
